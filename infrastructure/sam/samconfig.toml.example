version = 0.1

[default.deploy.parameters]
stack_name = "regenesis-dev"
resolve_s3 = true
s3_prefix = "regenesis"
region = "ap-south-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
parameter_overrides = "Environment=dev DetectionMode=auto SageMakerEndpointName="
image_repositories = []

[default.build.parameters]
cached = true
parallel = true
